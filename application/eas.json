{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "RCT_USE_RN_DEP": "0",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_PUBLIC_API_URL": "https://api.prolog.jooky.co.kr"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "RCT_USE_RN_DEP": "0",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_PUBLIC_API_URL": "https://api.prolog.jooky.co.kr"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "RCT_USE_RN_DEP": "0",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_PUBLIC_API_URL": "https://api.prolog.jooky.co.kr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
